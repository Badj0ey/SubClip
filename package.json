{
  "name": "subclip",
  "version": "3.18.5",
  "private": true,
  "description": "字幕剪 SubClip：基于字幕检索的 B站视频智能切片工作台。搜字幕，选片段，一键剪视频。",
  "license": "MIT",
  "author": "Badj0ey",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "bilibili",
    "subtitle",
    "srt",
    "subtitle-editor",
    "video-clip",
    "electron",
    "vue3"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "npm run test:core && npm run test:refactor && npm run test:wbi && npm run test:slice && npm run test:danmaku && npm run test:smoke && npm run test:bridge && npm run test:targets",
    "test:core": "esbuild tests/core.test.ts --bundle --platform=node --format=cjs --outfile=tests/core.test.cjs --alias:@shared=./src/shared --log-level=warning && node tests/core.test.cjs",
    "test:refactor": "esbuild tests/refactor.test.ts --bundle --platform=node --format=cjs --outfile=tests/refactor.test.cjs --alias:@shared=./src/shared --log-level=warning && node tests/refactor.test.cjs",
    "test:wbi": "esbuild tests/wbi.test.ts --bundle --platform=node --format=cjs --outfile=tests/wbi.test.cjs --log-level=warning && node tests/wbi.test.cjs",
    "test:slice": "esbuild tests/sidx.test.ts --bundle --platform=node --format=cjs --outfile=tests/sidx.test.cjs --alias:@shared=./src/shared --external:electron --log-level=warning && node tests/sidx.test.cjs",
    "test:danmaku": "esbuild tests/danmaku.test.ts --bundle --platform=node --format=cjs --outfile=tests/danmaku.test.cjs --log-level=warning && node tests/danmaku.test.cjs",
    "test:smoke": "esbuild tests/smoke.ts --bundle --platform=node --format=cjs --outfile=tests/smoke.cjs --alias:@shared=./src/shared --external:electron --external:xlsx --log-level=warning && electron tests/smoke.cjs",
    "test:bridge": "esbuild tests/bridge.smoke.ts --bundle --platform=node --format=cjs --outfile=tests/bridge.smoke.cjs --alias:@shared=./src/shared --external:electron --external:xlsx --external:ws --log-level=warning && electron tests/bridge.smoke.cjs",
    "test:targets": "esbuild tests/target-list.test.ts --bundle --platform=node --format=cjs --outfile=tests/target-list.test.cjs --log-level=warning && node tests/target-list.test.cjs",
    "dist": "npm run vendor:ffmpeg && npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run vendor:ffmpeg && npm run build && electron-builder --win --dir --publish never",
    "dist:checksums": "node scripts/checksums.mjs",
    "vendor:ffmpeg": "node scripts/fetch-ffmpeg.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "mitt": "^3.0.1",
    "pinia": "^4.0.3",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Badj0ey/SubClip.git"
  },
  "bugs": {
    "url": "https://github.com/Badj0ey/SubClip/issues"
  },
  "homepage": "https://github.com/Badj0ey/SubClip#readme"
}

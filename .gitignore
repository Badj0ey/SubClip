# 依赖
node_modules/

# 构建产物
out/
dist/
release/

# 构建缓存（tsconfig 开了 composite，会生成 .tsbuildinfo）
*.tsbuildinfo

# 测试产物（esbuild 打包出的中间文件与截图）
tests/*.cjs
tests/*.png
tests/large-*.srt

# 工具临时目录
.tmp-shot/

# 本地 npm 镜像配置（镜像源因人而异、也因网络环境而异，
# CI 在境外必须走默认源，所以只提交 .npmrc.example，不提交 .npmrc）
.npmrc

# Local development utilities
.embed-probe-cache/
.test-userdata/
scripts/*.png
*.log
.DS_Store
